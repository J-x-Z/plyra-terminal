; Independent Plyra Terminal. Launching this application explicitly opens a PTY.
config_version=5
[application]
config/name="Plyra Terminal"
config/version="0.1.0"
run/main_scene="res://standalone/main.tscn"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.06,0.07,0.08,1)
config/features=PackedStringArray("4.7","GL Compatibility")
[display]
window/subwindows/embed_subwindows=true
window/size/viewport_width=1000
window/size/viewport_height=700
window/stretch/mode="disabled"
[input_devices]
pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.06,0.07,0.08,1)
[debug]
file_logging/enable_file_logging=false
gdscript/warnings/untyped_declaration=0
